---
// The research genealogy: ideas and projects as a family tree over time.
// Laid out at build time as SVG, so it is complete and clickable without JavaScript.
// With JavaScript, scrolling through the stage replays the years: branches draw in,
// papers light up as evidence, abandoned branches fade, dormant ones are dashed.
import { history, lanes, type Node } from '../data/history';
import { visiblePosts } from '../data/posts';
import saved from '../data/activity.json';

// Recent activity: when each replikativ repository was last pushed to. Read from GitHub at build
// time (one request), with the saved copy as fallback so a failed request cannot break the build.
let pushed: Record<string, string> = saved.pushed;
try {
  const res = await fetch('https://api.github.com/orgs/replikativ/repos?per_page=100&sort=pushed', { signal: AbortSignal.timeout(4000) });
  if (res.ok) pushed = Object.fromEntries((await res.json()).map((r: { name: string; pushed_at: string }) => [r.name, r.pushed_at]));
} catch { /* keep the saved copy */ }
const WINDOW = 60 * 24 * 3600 * 1000; // two months
const activeDays = (n: { url?: string; repo?: string }) => {
  const repo = n.repo ?? n.url?.match(/github\.com\/replikativ\/([^/?#]+)/)?.[1];
  const at = repo && pushed[repo] ? Date.parse(pushed[repo]) : NaN;
  const age = Date.now() - at;
  return age >= 0 && age < WINDOW ? Math.floor(age / (24 * 3600 * 1000)) : null;
};

// Writing that explains a project, shown in its card.
const postsOf: Record<string, { t: string; u: string; s: string; pending: boolean }[]> = {};
for (const p of visiblePosts()) for (const id of p.projects) (postsOf[id] ??= []).push({ t: p.title, u: p.url, s: p.site, pending: p.pending });

const W = 1000, TOP = 26, LANE = 100, H = TOP + LANE * lanes.length + 34;
const X0 = 30, X1 = 975;
// Piecewise time axis: the early years are compressed, the recent burst is spread out.
const stops: [number, number][] = [[2007.6, 0], [2013, 0.11], [2025, 0.5], [2027, 1]];
const xOf = (y: number) => {
  for (let i = 1; i < stops.length; i++) {
    const [y0, f0] = stops[i - 1], [y1, f1] = stops[i];
    if (y <= y1) return X0 + (f0 + ((y - y0) / (y1 - y0)) * (f1 - f0)) * (X1 - X0);
  }
  return X1;
};
const laneIndex = Object.fromEntries(lanes.map((l, i) => [l.id, i]));
const laneMid = (i: number) => TOP + LANE * i + LANE / 2;

// Greedy vertical slots inside each lane so nearby nodes do not overlap.
const offsets = [0, -14, 14, -28, 28, -42, 42];
const lastX: Record<string, number[]> = {};
const byId: Record<string, Node & { x: number; y: number; alive: boolean; children: string[] }> = {};
for (const n of [...history].sort((a, b) => a.year - b.year)) {
  const x = xOf(n.year);
  const used = (lastX[n.lane] ??= offsets.map(() => -1e9));
  let slot = used.findIndex((lx) => x - lx > 22);
  if (slot < 0) slot = used.indexOf(Math.min(...used));
  used[slot] = x;
  byId[n.id] = { ...n, x, y: laneMid(laneIndex[n.lane]) + offsets[slot], alive: false, children: [] };
}
for (const n of history) for (const p of n.parents) byId[p]?.children.push(n.id);
// A branch is dead if it was dropped, or if everything that grew out of it was dropped.
// Work that continues without a listed successor stays alive.
const aliveOf = (id: string, seen = new Set<string>()): boolean => {
  const n = byId[id];
  if (n.status === 'dropped') return false;
  if (n.children.length === 0 || seen.has(id)) return true;
  seen.add(id);
  return n.children.some((c) => aliveOf(c, seen));
};
for (const id in byId) byId[id].alive = aliveOf(id);

const nodes = Object.values(byId);
const edges = history.flatMap((n) =>
  n.parents.filter((p) => byId[p]).map((p) => {
    const a = byId[p], b = byId[n.id];
    const dx = Math.max(24, (b.x - a.x) / 2);
    return {
      d: `M${a.x.toFixed(1)},${a.y.toFixed(1)} C${(a.x + dx).toFixed(1)},${a.y.toFixed(1)} ${(b.x - dx).toFixed(1)},${b.y.toFixed(1)} ${b.x.toFixed(1)},${b.y.toFixed(1)}`,
      from: a.year, to: b.year, alive: b.alive, dormant: a.status === 'revived' && b.year - a.year > 3, child: b.id,
    };
  }),
);
const ticks: [number, string][] = [[2008, '2008'], [2013, '2013'], [2016, '2016'], [2019, '2019'], [2022, '2022'], [2025, '2025'], [2026, '2026'], [2026.5, 'mid 2026']];
const kindName = { study: 'Study', project: 'Project', paper: 'Paper', company: 'Company', talk: 'Talk' };
const statusName = { continued: 'continued', dropped: 'ended', revived: 'dormant, then revived', current: 'current' };
---
<div class="genealogy-stage" data-genealogy>
  <div class="genealogy-sticky">
    <figure class="genealogy">
      <div class="scroller">
        <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby="genealogy-title">
          <title id="genealogy-title">My research as a family tree of ideas, 2008 to 2026</title>
          {lanes.map((l, i) => (
            <g class="lane">
              <line x1={X0} x2={X1} y1={TOP + LANE * (i + 1)} y2={TOP + LANE * (i + 1)} />
              <text x={X0} y={TOP + LANE * i + 14}>{l.name}</text>
            </g>
          ))}
          <g class="axis">
            {ticks.map(([t, label]) => (
              <text x={xOf(t)} y={H - 10} text-anchor="middle">{label}</text>
            ))}
          </g>
          <g class="edges">
            {edges.map((e) => (
              <path d={e.d} class:list={[{ alive: e.alive, dead: !e.alive, dormant: e.dormant }]}
                data-from={e.from} data-to={e.to} data-child={e.child} />
            ))}
          </g>
          <g class="nodes">
            {nodes.map((n) => {
              const label = `${n.label}, ${Math.floor(n.year)}. ${kindName[n.kind]}, ${statusName[n.status]}.`;
              const shape = n.kind === 'paper'
                ? <circle r="4.6" />
                : n.kind === 'company'
                  ? <rect x="-4.2" y="-4.2" width="8.4" height="8.4" />
                  : n.kind === 'talk'
                    ? <rect x="-3.8" y="-3.8" width="7.6" height="7.6" transform="rotate(45)" />
                    : n.kind === 'study'
                      ? <circle r="4.6" class="ring" />
                      : <circle r="3.4" />;
              const body = (
                <g transform={`translate(${n.x.toFixed(1)},${n.y.toFixed(1)})`}
                  class:list={['node', n.kind, n.status, { alive: n.alive, dead: !n.alive, active: activeDays(n) !== null }]}
                  style={activeDays(n) !== null ? `--delay:${(n.x % 7) * 0.4}s; --strength:${(1 - 0.75 * activeDays(n)! / 60).toFixed(2)}` : undefined}
                  data-year={n.year} data-id={n.id} data-label={n.label} data-meta={`${Math.floor(n.year)} · ${kindName[n.kind]} · ${statusName[n.status]}`}
                  data-url={n.url} data-posts={postsOf[n.id] ? JSON.stringify(postsOf[n.id]) : undefined}>
                  <circle r="11" class="hit" />
                  {activeDays(n) !== null && <circle r="4" class="pulse" />}
                  {shape}
                  {postsOf[n.id] && <circle r="1.6" cy="-8" class="has-posts" />}
                </g>
              );
              return n.url
                ? <a href={n.url} aria-label={label}>{body}</a>
                : <g role="img" aria-label={label} tabindex="0">{body}</g>;
            })}
          </g>
        </svg>
        <div class="tip" hidden></div>
      </div>
      <figcaption>
        <span class="ticker" aria-hidden="true"><span class="year"></span> <span class="event"></span></span>
        <span class="legend">Each line is an idea or project that grew out of earlier ones. Ochre dots are papers, squares are companies, diamonds are talks. Grey branches ended; dashed lines are ideas that lay dormant for years and came back. Hover for names, select for code and writing; a small dot above marks projects with writing. A slow pulse marks projects whose repository changed in the last two months, stronger for more recent changes.</span>
      </figcaption>
    </figure>
  </div>
</div>

<style>
  .genealogy-stage { position: relative; }
  :global(html.js) .genealogy-stage.animate { height: 175vh; }
  .genealogy-sticky { position: sticky; top: 0; min-height: 100vh; display: grid; align-content: center; }
  .genealogy-stage:not(.animate) .genealogy-sticky { position: static; min-height: 0; }
  .genealogy { gap: 10px; }
  .scroller { position: relative; }
  @media (max-width: 760px) { .scroller { overflow-x: auto; } }
  svg { display: block; width: 100%; min-width: 720px; height: auto; font-family: var(--serif); }
  .lane line { stroke: var(--rule); stroke-width: 1; }
  .lane text { fill: var(--muted); font-family: var(--display); font-size: 12.5px; letter-spacing: 0.01em; }
  .axis text { fill: var(--muted); font-family: var(--display); font-size: 12px; font-variant-numeric: tabular-nums; }
  .edges path { fill: none; stroke-width: 1.2; stroke: var(--predict); opacity: .5; transition: stroke .6s, opacity .6s; }
  .edges path.dormant { stroke-dasharray: 3 4; }
  .edges path.dead.gone { stroke: var(--muted); opacity: .35; }
  .node { color: var(--ink); fill: var(--ink); transition: opacity .4s, fill .6s; cursor: pointer; }
  .node .hit { fill: transparent; }
  .node .ring { fill: var(--paper); stroke: var(--ink); stroke-width: 1.6; }
  .node.paper { fill: var(--evidence); }
  .node.current { fill: var(--predict); }
  .node .pulse { fill: none; stroke: var(--predict); stroke-width: 1.2; opacity: 0; transform-box: fill-box; transform-origin: center;
    animation: tree-pulse 3.6s ease-out infinite; animation-delay: var(--delay, 0s); }
  @keyframes tree-pulse { 0% { transform: scale(1); opacity: calc(0.75 * var(--strength, 1)); } 70%, 100% { transform: scale(3.4); opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .node .pulse { animation: none; opacity: .5; transform: scale(2); } }
  .node.dead.gone { fill: var(--muted); opacity: .55; }
  .node.dead.gone .ring { stroke: var(--muted); }
  a:focus-visible .node .hit, g[tabindex]:focus-visible .node .hit { stroke: var(--predict); stroke-width: 2; }
  :global(html.js) .animate .node.hidden, :global(html.js) .animate .edges path.hidden { opacity: 0; }
  .node.flash .hit { fill: var(--evidence); opacity: .25; }
  .tip {
    position: absolute; pointer-events: none; max-width: 260px; padding: 6px 10px;
    background: var(--paper); border: 1px solid var(--rule); font-size: 15px; line-height: 1.35;
  }
  .tip :global(small) { display: block; color: var(--muted); font-size: 13px; }
  .tip.pinned { pointer-events: auto; max-width: 320px; padding: 10px 12px; display: grid; gap: 6px; box-shadow: 0 6px 20px color-mix(in srgb, var(--ink) 12%, transparent); }
  .tip :global(ul) { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; font-size: 15px; }
  .tip :global(.site) { color: var(--muted); font-size: 13px; }
  .tip :global(.pending) { color: var(--surprise); font-size: 12px; }
  .node .has-posts { fill: var(--ink); }
  figcaption { display: grid; gap: 4px; }
  .ticker { color: var(--ink); font-family: var(--display); font-size: 15px; min-height: 1.4em; }
  .ticker .year { font-variant-numeric: tabular-nums; color: var(--predict); }
  .genealogy-stage:not(.animate) .ticker { display: none; }
</style>

<script>
  document.documentElement.classList.add('js');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  for (const stage of document.querySelectorAll<HTMLElement>('[data-genealogy]')) {
    const svg = stage.querySelector('svg')!;
    const tip = stage.querySelector<HTMLElement>('.tip')!;
    const scroller = stage.querySelector<HTMLElement>('.scroller')!;
    const nodes = [...stage.querySelectorAll<SVGGElement>('.node')];
    const edges = [...stage.querySelectorAll<SVGPathElement>('.edges path')];

    // Names on hover and focus.
    const show = (n: SVGGElement) => {
      const r = n.getBoundingClientRect(), c = scroller.getBoundingClientRect();
      tip.innerHTML = '';
      tip.classList.remove('pinned');
      tip.append(document.createTextNode(n.dataset.label!));
      const s = document.createElement('small'); s.textContent = n.dataset.meta!; tip.append(s);
      tip.hidden = false;
      const left = r.left - c.left + scroller.scrollLeft + 14;
      tip.style.left = Math.min(left, scroller.scrollWidth - 270) + 'px';
      tip.style.top = (r.top - c.top + 12) + 'px';
    };
    // A pinned card with links to the code and to writing about the project.
    let pinned: SVGGElement | null = null;
    const place = (n: SVGGElement) => {
      const r = n.getBoundingClientRect(), c = scroller.getBoundingClientRect();
      const left = r.left - c.left + scroller.scrollLeft + 14;
      tip.style.left = Math.max(0, Math.min(left, scroller.scrollWidth - 330)) + 'px';
      tip.style.top = (r.top - c.top + 12) + 'px';
    };
    const pin = (n: SVGGElement) => {
      pinned = n;
      tip.innerHTML = '';
      tip.classList.add('pinned');
      const title = document.createElement('div'); title.textContent = n.dataset.label!; tip.append(title);
      const meta = document.createElement('small'); meta.textContent = n.dataset.meta!; tip.append(meta);
      const list = document.createElement('ul');
      const add = (text: string, href: string, note?: string, pending?: boolean) => {
        const li = document.createElement('li');
        const a = document.createElement('a'); a.href = href; a.textContent = text; li.append(a);
        if (note) { const s = document.createElement('span'); s.className = 'site'; s.textContent = ' ' + note; li.append(s); }
        if (pending) { const s = document.createElement('span'); s.className = 'pending'; s.textContent = ' pending review'; li.append(s); }
        list.append(li);
      };
      if (n.dataset.url) add(n.dataset.url.includes('github.com') ? 'Code' : 'Website', n.dataset.url);
      for (const p of JSON.parse(n.dataset.posts || '[]')) add(p.t, p.u, p.s, p.pending);
      if (list.children.length) tip.append(list);
      tip.hidden = false;
      place(n);
    };
    const unpin = () => { pinned = null; tip.classList.remove('pinned'); tip.hidden = true; };
    for (const n of nodes) {
      const host = (n.parentElement as Element);
      host.addEventListener('pointerenter', () => { if (!pinned) show(n); });
      host.addEventListener('pointerleave', () => { if (!pinned) tip.hidden = true; });
      host.addEventListener('focus', () => { if (!pinned) show(n); });
      host.addEventListener('blur', () => { if (!pinned) tip.hidden = true; });
      host.addEventListener('click', (e) => { e.preventDefault(); e.stopPropagation(); pinned === n ? unpin() : pin(n); });
      host.addEventListener('keydown', (e) => { if ((e as KeyboardEvent).key === 'Enter' && host.tagName !== 'a') { e.preventDefault(); pin(n); } });
    }
    document.addEventListener('click', (e) => { if (pinned && !tip.contains(e.target as Node)) unpin(); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && pinned) unpin(); });

    if (reduce) continue;
    // Replay the years while the stage scrolls past.
    stage.classList.add('animate');
    const lens = edges.map((e) => e.getTotalLength());
    edges.forEach((e, i) => { e.style.strokeDasharray = e.classList.contains('dormant') ? '' : `${lens[i]}`; });
    const sorted = [...nodes].sort((a, b) => +a.dataset.year! - +b.dataset.year!);
    const yearEl = stage.querySelector('.ticker .year')!, eventEl = stage.querySelector('.ticker .event')!;
    const START = 2007.6, END = 2027.0;
    let last = -1;
    const update = () => {
      const r = stage.getBoundingClientRect();
      const span = r.height - innerHeight;
      const p = span > 0 ? Math.min(1, Math.max(0, -r.top / span)) : 1;
      const cut = START + p * (END - START);
      if (Math.abs(cut - last) < 0.005) return;
      last = cut;
      for (const n of nodes) {
        const y = +n.dataset.year!;
        n.classList.toggle('hidden', y > cut);
        n.classList.toggle('gone', cut > y + 1.2);
        n.classList.toggle('flash', n.classList.contains('paper') && cut >= y && cut < y + 0.6);
      }
      edges.forEach((e, i) => {
        const a = +e.dataset.from!, b = +e.dataset.to!;
        const f = Math.min(1, Math.max(0, (cut - a) / Math.max(0.15, b - a)));
        e.classList.toggle('hidden', f <= 0);
        if (!e.classList.contains('dormant')) e.style.strokeDashoffset = `${lens[i] * (1 - f)}`;
        e.classList.toggle('gone', cut > b + 1.2);
      });
      const seen = sorted.filter((n) => +n.dataset.year! <= cut);
      yearEl.textContent = String(Math.min(2026, Math.floor(cut)));
      eventEl.textContent = seen.length ? seen[seen.length - 1].dataset.label! : '';
    };
    let ticking = false;
    addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(() => { ticking = false; update(); }); } }, { passive: true });
    addEventListener('resize', update);
    update();
  }
</script>
