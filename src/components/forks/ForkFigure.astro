---
// A fork diagram: time runs left to right, wires are state, a dot copies a wire, a ground
// symbol drops it. The shared vocabulary (classes below) is meant to grow into the visual
// language of Klara and Simmis:
//   .st  accepted state (ink)            .th  a thought: speculative, dropped (blue, dashed)
//   .tr  an attempt (blue)               .gate  a check (ochre)
//   .rt  retired or rejected (vermilion) .vl  the values (double ink line)
//   .ghost-only  drawn faintly, never inked (structure that does not happen in time)
// As the figure scrolls through the window, a sweep inks it in from left to right over a
// faint copy of the whole, so the structure is always readable and the order is shown by
// the sweep. Without JavaScript or with reduced motion the figure is shown complete.
interface Props { width: number; height: number; label: string }
const { width: W, height: H, label } = Astro.props;
const inner = await Astro.slots.render('default');
const caption = await Astro.slots.render('caption');
const cid = `fk-${Math.random().toString(36).slice(2, 8)}`;
---
<figure class="forkfig" data-forkfig data-w={W}>
  <div class="frame">
    <svg viewBox={`0 0 ${W} ${H}`} width={W} height={H} role="img" aria-label={label}>
      <defs><clipPath id={cid}><rect class="sweep" x="0" y="0" width={W} height={H} /></clipPath></defs>
      <g class="ghost" aria-hidden="true" set:html={inner} />
      <g class="ink" clip-path={`url(#${cid})`} set:html={inner} />
      <line class="cursor" x1={W} x2={W} y1="4" y2={H - 4} />
    </svg>
  </div>
  {caption && <figcaption set:html={caption} />}
</figure>

<style is:global>
  .forkfig { margin: 30px 0 10px; }
  .forkfig .frame { overflow-x: auto; -webkit-overflow-scrolling: touch; }
  .forkfig svg { display: block; width: 100%; height: auto; overflow: visible; }
  .forkfig figcaption { font-family: var(--display); font-size: 14px; line-height: 1.45; color: var(--muted); margin-top: 6px; }
  /* Phones: keep labels legible and let the figure scroll sideways inside its frame. */
  @media (max-width: 640px) { .forkfig svg { width: auto; min-width: 560px; } }

  .forkfig .ghost { opacity: 0.16; }
  .forkfig .ghost .ghost-hide { display: none; }
  .forkfig .ink .ghost-only { display: none; }
  .forkfig .cursor { stroke: var(--muted); stroke-width: 1; opacity: 0; transition: opacity 200ms; }
  .forkfig[data-moving] .cursor { opacity: 0.35; }

  .forkfig path, .forkfig line, .forkfig rect, .forkfig polyline { fill: none; vector-effect: non-scaling-stroke; }
  .forkfig .st { stroke: var(--ink); stroke-width: 2; }
  .forkfig .st.idle { stroke: var(--muted); stroke-width: 1.5; }
  .forkfig .th { stroke: var(--predict); stroke-width: 1.5; stroke-dasharray: 5 4; }
  .forkfig .tr { stroke: var(--predict); stroke-width: 2; }
  .forkfig .rt { stroke: var(--surprise); stroke-width: 2; }
  .forkfig .rt.thin { stroke-width: 1.25; stroke-dasharray: 3 3; }
  .forkfig .vl { stroke: var(--ink); stroke-width: 1.25; }
  .forkfig .premise { stroke: var(--muted); stroke-width: 1; stroke-dasharray: 1 3; }
  .forkfig .box { stroke: var(--predict); stroke-width: 1; stroke-dasharray: 2 3; }
  .forkfig .box.solid { stroke-dasharray: none; }
  .forkfig .ground { stroke: var(--muted); stroke-width: 1.5; }
  .forkfig .ground.rt { stroke: var(--surprise); }
  .forkfig .gate { fill: var(--evidence); stroke: none; }
  .forkfig .gate-o { stroke: var(--evidence); stroke-width: 1.75; fill: var(--paper); }
  .forkfig .dot { fill: var(--ink); }
  .forkfig .dot.p { fill: var(--predict); }
  .forkfig .dot.o { fill: var(--paper); stroke: var(--ink); stroke-width: 1.5; }
  .forkfig .mark { stroke: var(--evidence); stroke-width: 2; fill: none; }
  .forkfig text { font-family: var(--display); font-size: 13px; fill: var(--muted); }
  .forkfig text.k { fill: var(--ink); }
  .forkfig text.b { fill: var(--predict); }
  .forkfig text.o { fill: var(--evidence); }
  .forkfig text.r { fill: var(--surprise); }
  .forkfig text.s { font-size: 11.5px; }
  .forkfig text.mono { font-family: var(--mono); font-size: 12px; }
</style>

<script>
  // Scroll-linked sweep: starts when the figure's top enters the lower part of the window and
  // completes when its middle reaches the upper half, so the figure is complete while read.
  const figs = [...document.querySelectorAll<HTMLElement>('[data-forkfig]')];
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (figs.length && !reduce) {
    const items = figs.map((f) => ({
      f, W: Number(f.dataset.w), frame: f.querySelector<HTMLElement>('.frame')!, svg: f.querySelector('svg')!,
      rect: f.querySelector<SVGRectElement>('.sweep')!, cur: f.querySelector<SVGLineElement>('.cursor')!,
    }));
    let queued = false;
    const update = () => {
      queued = false;
      const vh = innerHeight;
      for (const { f, W, frame, svg, rect, cur } of items) {
        const r = f.getBoundingClientRect();
        const start = vh * 0.95, end = vh * 0.42 - r.height / 2;
        const p = Math.max(0, Math.min(1, (start - r.top) / (start - end)));
        const x = (p * W).toFixed(1);
        rect.setAttribute('width', x); cur.setAttribute('x1', x); cur.setAttribute('x2', x);
        const moving = p > 0.002 && p < 0.998;
        if (moving) f.setAttribute('data-moving', ''); else f.removeAttribute('data-moving');
        // On narrow screens the figure is wider than its frame: pan so the present stays in view.
        const over = frame.scrollWidth - frame.clientWidth;
        if (over > 1 && moving) {
          frame.scrollLeft = Math.max(0, Math.min(over, p * svg.clientWidth - frame.clientWidth * 0.7));
        }
      }
    };
    const queue = () => { if (!queued) { queued = true; requestAnimationFrame(update); } };
    addEventListener('scroll', queue, { passive: true }); addEventListener('resize', queue);
    update();
  }
</script>
