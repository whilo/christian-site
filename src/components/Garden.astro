---
// A small garden of forking paths: a particle filter running slowly, like a clock.
// Paths grow from one point and fork; where they meet an observation, the ones that
// predicted it badly stop and the others fork again. One run takes about twenty seconds.
// Nothing reacts to the reader. With reduced motion, one finished run is shown.
---
<figure class="garden" data-garden>
  <canvas aria-label="Paths fork from a point; at three observations the paths that miss stop and the others fork again"></canvas>
  <figcaption>
    Paths fork, and at each observation the ones that predicted it badly stop.
  </figcaption>
</figure>

<style>
  .garden { gap: 8px; }
  canvas { display: block; width: 100%; height: 150px; }
  @media (max-width: 980px) { .garden { display: none; } }
</style>

<script>
  const rng = (seed) => () => { seed |= 0; seed = seed + 0x6D2B79F5 | 0; let t = Math.imul(seed ^ seed >>> 15, 1 | seed);
    t = t + Math.imul(t ^ t >>> 7, 61 | t) ^ t; return ((t ^ t >>> 14) >>> 0) / 4294967296; };
  const gauss = (r) => { let u = 0; while (!u) u = r(); return Math.sqrt(-2 * Math.log(u)) * Math.cos(2 * Math.PI * r()); };

  // One run of the filter: K steps, N paths, observations at three steps.
  const K = 48, N = 18, OBS = [14, 26, 37], SIG = 0.13;
  const simulate = (seed) => {
    const r = rng(seed), phase = r() * 6;
    const truth = (k) => 0.45 * Math.sin(4.2 * k / (K - 1) + phase) * (k / (K - 1));
    const obs = OBS.map((k) => ({ k, y: truth(k) + gauss(r) * 0.03 }));
    let y = new Float64Array(N), v = Float64Array.from({ length: N }, () => gauss(r) * 1.1);
    const seg = [null], anc = [null];
    for (let k = 1; k < K; k++) {
      const y0 = Float64Array.from(y);
      for (let i = 0; i < N; i++) { v[i] += gauss(r) * 0.2; y[i] += v[i] / (K - 1); }
      seg.push({ y0, y1: Float64Array.from(y) });
      const a = Int32Array.from({ length: N }, (_, i) => i), o = obs.find((o) => o.k === k);
      if (o) { // resample in proportion to how well each path predicted the observation
        const w = Float64Array.from(y, (yi) => Math.exp(-0.5 * ((yi - o.y) / SIG) ** 2) + 1e-12), sum = w.reduce((p, q) => p + q, 0);
        let c = w[0] / sum, j = 0; const u0 = r() / N;
        for (let i = 0; i < N; i++) { const u = u0 + i / N; while (u > c && j < N - 1) { j++; c += w[j] / sum; } a[i] = j; }
        y = Float64Array.from(a, (j) => y[j]); v = Float64Array.from(a, (j) => v[j] + gauss(r) * 0.5);
      }
      anc.push(a);
    }
    // which paths have a descendant at the end, and where each one stops
    const alive = [], last = []; let al = new Uint8Array(N).fill(1), la = new Float64Array(N).fill(K - 1);
    for (let k = K - 1; k >= 1; k--) {
      const pa = new Uint8Array(N), pl = new Float64Array(N).fill(k);
      for (let i = 0; i < N; i++) { const j = anc[k][i]; if (al[i]) pa[j] = 1; pl[j] = Math.max(pl[j], la[i]); }
      alive[k] = pa; last[k] = pl; al = pa; la = pl;
    }
    return { seg, obs, alive, last };
  };

  for (const fig of document.querySelectorAll('[data-garden]')) {
    const cv = fig.querySelector('canvas'), ctx = cv.getContext('2d');
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let col = {}, W = 0, H = 0;
    const colours = () => { const s = getComputedStyle(document.documentElement);
      for (const k of ['predict', 'evidence', 'muted', 'ink']) col[k] = s.getPropertyValue('--' + k).trim(); };
    const fit = () => { const d = Math.min(2, devicePixelRatio || 1); W = cv.clientWidth; H = cv.clientHeight;
      cv.width = W * d; cv.height = H * d; ctx.setTransform(d, 0, 0, d, 0, 0); };
    colours(); fit(); addEventListener('resize', fit);
    matchMedia('(prefers-color-scheme: dark)').addEventListener('change', colours);

    const GROW = 15000, HOLD = 4500, FADE = 1500, CYCLE = GROW + HOLD + FADE;
    let seed = 7, run = simulate(seed), cycle = -1;
    const X = (k) => 6 + (k / (K - 1)) * (W - 12), Y = (y) => H / 2 - Math.max(-1.1, Math.min(1.1, y)) * H * 0.42;

    const draw = (t) => {
      const c = Math.floor(t / CYCLE), tc = t - c * CYCLE;
      if (c !== cycle) { cycle = c; run = simulate(seed + c * 13); }
      const rv = reduce ? K - 1 : Math.min(K - 1, 1 + (tc / GROW) * (K - 2));
      const fade = reduce ? 1 : 1 - Math.max(0, (tc - GROW - HOLD) / FADE);
      ctx.clearRect(0, 0, W, H); ctx.lineWidth = 1;
      // three kinds of path (stopped, alive, about to stop), each drawn as one stroke
      for (const kind of [0, 1, 2]) {
        ctx.beginPath();
        for (let k = 1; k < K && k - 1 <= rv; k++) {
          const f = Math.min(1, rv - (k - 1)), s = run.seg[k];
          for (let j = 0; j < N; j++) {
            const stopped = !run.alive[k][j] && rv > run.last[k][j] + 0.5;
            if ((stopped ? 0 : run.alive[k][j] ? 1 : 2) !== kind) continue;
            ctx.moveTo(X(k - 1), Y(s.y0[j])); ctx.lineTo(X(k - 1 + f), Y(s.y0[j] + (s.y1[j] - s.y0[j]) * f));
          }
        }
        ctx.strokeStyle = kind === 0 ? col.muted : col.predict;
        ctx.globalAlpha = [0.22, 0.7, 0.45][kind] * fade;
        ctx.stroke();
      }
      ctx.strokeStyle = ctx.fillStyle = col.evidence; ctx.lineWidth = 1.5;
      for (const o of run.obs) {
        const a = Math.max(0, Math.min(1, rv - o.k + 1)) * fade; if (!a) continue;
        ctx.globalAlpha = a; const x = X(o.k);
        ctx.beginPath(); ctx.moveTo(x, Y(o.y + 2 * SIG)); ctx.lineTo(x, Y(o.y - 2 * SIG)); ctx.stroke();
        ctx.beginPath(); ctx.arc(x, Y(o.y), 2.6, 0, 7); ctx.fill();
      }
      ctx.globalAlpha = fade; ctx.fillStyle = col.ink; ctx.beginPath(); ctx.arc(X(0), Y(0), 2.6, 0, 7); ctx.fill();
      ctx.globalAlpha = 1;
    };

    if (reduce) { draw(0); continue; }
    let visible = true, t0 = performance.now();
    new IntersectionObserver((es) => { visible = es[0].isIntersecting; }).observe(cv);
    const frame = (t) => { if (visible && !document.hidden) draw(t - t0); requestAnimationFrame(frame); };
    requestAnimationFrame(frame);
  }
</script>
